# Copy to .env and adjust.
# Docker runs rootless here: container root == host user, so no UID/GID mapping.
ORCA_DIR=/opt/orca
# ORCA scratch (large temporary files); needs ~150 GB free for the baseline campaign.
SCRATCH_DIR=/var/tmp/hclust
# Host port for the wiki preview (docs profile).
DOCS_PORT=8001
# Host address the wiki preview listens on. Set to the Tailscale IP
# (tailscale ip -4) to read it from other devices on the tailnet.
DOCS_BIND=127.0.0.1

# HTTP API (docker compose --profile serve up api)
API_PORT=8000

# Web app (docker compose --profile serve up): dev server, and the nginx build (--profile prod)
WEB_PORT=5173
WEB_PROD_PORT=8080
